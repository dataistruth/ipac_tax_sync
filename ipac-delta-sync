#!/usr/bin/env bash
# Run ipac_delta_sync CLI from repo root without installing a package.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
export PYTHONPATH="${ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
if command -v uv >/dev/null 2>&1; then
  exec uv run python -m util.cli "$@"
else
  exec python -m util.cli "$@"
fi
